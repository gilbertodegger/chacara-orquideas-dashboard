rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function active() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true;
    }
    function admin() {
      return active() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Configurações sincronizadas: apenas o administrador pode alterar.
    match /configuracoes/{configId} {
      allow read: if configId == 'opcoes' && active();
      allow create, update: if configId == 'opcoes' && admin()
        && request.resource.data.keys().hasOnly(['setores','responsaveis','tipos','updatedByUid','updatedAt'])
        && request.resource.data.keys().hasAll(['setores','responsaveis','tipos','updatedByUid','updatedAt'])
        && request.resource.data.setores is list
        && request.resource.data.responsaveis is list
        && request.resource.data.tipos is list
        && request.resource.data.setores.size() <= 60
        && request.resource.data.responsaveis.size() <= 60
        && request.resource.data.tipos.size() <= 60
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Máquinas — somente administrador pode cadastrar, editar ou registrar troca de óleo.
    match /maquinas/{machineId} {
      allow read: if active();
      allow create: if admin()
        && request.resource.data.keys().hasOnly([
          'marca','modelo','numeroSerie','anoModelo','seguro','observacoes','pecas',
          'horimetroAtual','intervaloHoras','intervaloMeses','ultimaTrocaData','ultimaTrocaHoras',
          'createdByUid','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'marca','modelo','numeroSerie','anoModelo','seguro','observacoes','pecas',
          'horimetroAtual','intervaloHoras','intervaloMeses','ultimaTrocaData','ultimaTrocaHoras',
          'createdByUid','createdAt','updatedAt'
        ])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && validMachine();
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'marca','modelo','numeroSerie','anoModelo','seguro','observacoes','pecas',
          'horimetroAtual','intervaloHoras','intervaloMeses','ultimaTrocaData','ultimaTrocaHoras','updatedAt'
        ])
        && validMachine();
      allow delete: if admin();
      function validMachine() {
        return request.resource.data.marca is string
          && request.resource.data.marca.size() > 0
          && request.resource.data.marca.size() <= 80
          && request.resource.data.modelo is string
          && request.resource.data.modelo.size() > 0
          && request.resource.data.modelo.size() <= 80
          && request.resource.data.numeroSerie is string
          && request.resource.data.numeroSerie.size() <= 100
          && request.resource.data.anoModelo is string
          && request.resource.data.anoModelo.size() <= 30
          && request.resource.data.seguro in ['','Sim','Não']
          && request.resource.data.observacoes is string
          && request.resource.data.observacoes.size() <= 4000
          && request.resource.data.pecas is list
          && request.resource.data.pecas.size() <= 40
          && (request.resource.data.horimetroAtual == null
            || (request.resource.data.horimetroAtual is number && request.resource.data.horimetroAtual >= 0))
          && (request.resource.data.intervaloHoras == null
            || (request.resource.data.intervaloHoras is number && request.resource.data.intervaloHoras > 0))
          && (request.resource.data.intervaloMeses == null
            || (request.resource.data.intervaloMeses is number && request.resource.data.intervaloMeses > 0))
          && request.resource.data.ultimaTrocaData is string
          && request.resource.data.ultimaTrocaData.size() <= 10
          && (request.resource.data.ultimaTrocaHoras == null
            || (request.resource.data.ultimaTrocaHoras is number && request.resource.data.ultimaTrocaHoras >= 0))
          && request.resource.data.updatedAt == request.time;
      }
      match /revisoes/{revisionId} {
        allow read: if active();
        allow create: if admin()
          && request.resource.data.keys().hasOnly([
            'tipo','data','horimetro','observacoes','createdAt','createdByUid'
          ])
          && request.resource.data.keys().hasAll([
            'tipo','data','horimetro','observacoes','createdAt','createdByUid'
          ])
          && request.resource.data.tipo == 'Troca de Óleo'
          && request.resource.data.data is string
          && request.resource.data.data.size() == 10
          && (request.resource.data.horimetro == null
            || (request.resource.data.horimetro is number && request.resource.data.horimetro >= 0))
          && request.resource.data.observacoes is string
          && request.resource.data.observacoes.size() <= 1500
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if false;
        allow delete: if admin();
      }
    }
    match /auditoriaEquipamentos/{logId} {
      allow read: if active();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['machineId','marca','modelo','numeroSerie','revisoesExcluidas','actorUid','actorEmail','at'])
        && request.resource.data.keys().hasAll(['machineId','marca','modelo','numeroSerie','revisoesExcluidas','actorUid','actorEmail','at'])
        && request.resource.data.machineId is string
        && request.resource.data.marca is string
        && request.resource.data.modelo is string
        && request.resource.data.numeroSerie is string
        && request.resource.data.revisoesExcluidas is int
        && request.resource.data.revisoesExcluidas >= 0
        && request.resource.data.revisoesExcluidas < 450
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    // Componentes Independentes de Ordenha. Edição Apenas pelo Administrador.
    match /manutencaoOrdenha/teteiras/componentes/{componentId} {
      allow read: if active() && componentId in ['kit-iq','kit-vaso','mangueira-silicone'];
      allow create, update: if admin()
        && componentId in ['kit-iq','kit-vaso','mangueira-silicone']
        && request.resource.data.keys().hasOnly(['material','dataTroca','limiteOrdenhas','limiteMeses','observacoes','updatedByUid','updatedAt'])
        && request.resource.data.keys().hasAll(['material','dataTroca','limiteOrdenhas','limiteMeses','observacoes','updatedByUid','updatedAt'])
        && request.resource.data.material is string
        && request.resource.data.dataTroca is string
        && request.resource.data.dataTroca.size() <= 10
        && (request.resource.data.dataTroca == '' || request.resource.data.dataTroca.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && request.resource.data.observacoes is string
        && request.resource.data.observacoes.size() <= 1200
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (
          (componentId == 'mangueira-silicone'
            && request.resource.data.material == 'Silicone'
            && (request.resource.data.limiteOrdenhas == null ||
               (request.resource.data.limiteOrdenhas is int && request.resource.data.limiteOrdenhas >= 1 && request.resource.data.limiteOrdenhas <= 1000000))
            && (request.resource.data.limiteMeses == null ||
               (request.resource.data.limiteMeses is int && request.resource.data.limiteMeses >= 1 && request.resource.data.limiteMeses <= 1000000)))
          ||
          (componentId in ['kit-iq','kit-vaso']
            && ((request.resource.data.material == 'Borracha' && request.resource.data.limiteOrdenhas == 2500 && request.resource.data.limiteMeses == 6)
            || (request.resource.data.material == 'Silicone' && request.resource.data.limiteOrdenhas == 5000 && request.resource.data.limiteMeses == 12)))
        );
      allow delete: if false;
      match /trocas/{trocaId} {
        allow read: if active();
        allow create: if admin()
          && request.resource.data.keys().hasOnly(['data','material','observacoes','createdAt','createdByUid'])
          && request.resource.data.keys().hasAll(['data','material','observacoes','createdAt','createdByUid'])
          && request.resource.data.data is string
          && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.material is string
          && ((componentId == 'mangueira-silicone' && request.resource.data.material == 'Silicone')
            || (componentId in ['kit-iq','kit-vaso'] && request.resource.data.material in ['Borracha','Silicone']))
          && request.resource.data.observacoes is string
          && request.resource.data.observacoes.size() <= 1200
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /manutencaoOrdenha/{configId} {
      allow read: if configId == 'teteiras' && active();
      allow create, update: if configId == 'teteiras' && admin()
        && request.resource.data.keys().hasOnly(['conjuntos','ordenhasDia','vacas','duracoes','dataTroca','limiteHoras','limiteOrdenhas','observacoes','updatedAt','updatedByUid'])
        && request.resource.data.keys().hasAll(['conjuntos','ordenhasDia','vacas','duracoes','dataTroca','limiteHoras','limiteOrdenhas','observacoes','updatedAt','updatedByUid'])
        && request.resource.data.conjuntos is int
        && request.resource.data.conjuntos >= 1
        && request.resource.data.conjuntos <= 100
        && request.resource.data.ordenhasDia == 3
        && (request.resource.data.vacas == null ||
          (request.resource.data.vacas is int && request.resource.data.vacas >= 1 && request.resource.data.vacas <= 5000))
        && request.resource.data.duracoes is list
        && request.resource.data.duracoes.size() == 3
        && (request.resource.data.duracoes[0] == null ||
          (request.resource.data.duracoes[0] is number && request.resource.data.duracoes[0] > 0 && request.resource.data.duracoes[0] <= 15))
        && (request.resource.data.duracoes[1] == null ||
          (request.resource.data.duracoes[1] is number && request.resource.data.duracoes[1] > 0 && request.resource.data.duracoes[1] <= 15))
        && (request.resource.data.duracoes[2] == null ||
          (request.resource.data.duracoes[2] is number && request.resource.data.duracoes[2] > 0 && request.resource.data.duracoes[2] <= 15))
        && request.resource.data.dataTroca is string
        && request.resource.data.dataTroca.size() <= 10
        && (request.resource.data.dataTroca == '' ||
          request.resource.data.dataTroca.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (request.resource.data.limiteHoras == null ||
          (request.resource.data.limiteHoras is number && request.resource.data.limiteHoras > 0))
        && request.resource.data.limiteOrdenhas == 5000
        && request.resource.data.observacoes is string
        && request.resource.data.observacoes.size() <= 1500
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
      match /trocas/{trocaId} {
        allow read: if active();
        allow create: if admin()
          && request.resource.data.keys().hasOnly(['data','conjuntos','observacoes','createdAt','createdByUid'])
          && request.resource.data.keys().hasAll(['data','conjuntos','observacoes','createdAt','createdByUid'])
          && request.resource.data.data is string
          && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.conjuntos is int
          && request.resource.data.conjuntos >= 1
          && request.resource.data.conjuntos <= 100
          && request.resource.data.observacoes is string
          && request.resource.data.observacoes.size() <= 1500
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /tarefas/{taskId} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['title','type','priority','sector','assignee','dueAt','details','status','createdByUid','createdByEmail','createdAt','updatedAt','recurrence','recurrenceUntil'])
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.status == 'aberta'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 130
        && request.resource.data.priority in ['Baixa','Normal','Urgente','Crítica']
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 80
        && (request.resource.data.type == 'Ocorrência' || admin())
        && request.resource.data.sector is string
        && request.resource.data.sector.size() <= 120
        && request.resource.data.assignee is string
        && request.resource.data.assignee.size() <= 80
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 3000
        && request.resource.data.dueAt is string
        && request.resource.data.dueAt.size() <= 25
        && request.resource.data.get('recurrence','none') in ['none','weekly']
        && request.resource.data.get('recurrenceUntil','') is string
        && request.resource.data.get('recurrenceUntil','').size() <= 10
        && (request.resource.data.get('recurrenceUntil','') == '' ||
          request.resource.data.get('recurrenceUntil','').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (request.resource.data.get('recurrence','none') != 'weekly' ||
          (admin() && request.resource.data.type == 'Evento'))
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if active()
        && resource.data.get('recurrence','none') != 'weekly'
        && resource.data.status in ['aberta','andamento']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','updatedAt','lastActionByUid','lastActionByEmail','lastActionByName',
          'completedBy','completedByUid','completedAt','completedAtLocal','completionNote'
        ])
        && request.resource.data.status in ['andamento','concluida']
        && (request.resource.data.status == 'concluida' || resource.data.status == 'aberta')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActionByUid == request.auth.uid
        && request.resource.data.lastActionByName is string
        && request.resource.data.lastActionByName.size() > 0
        && (request.resource.data.status != 'concluida' || (
          request.resource.data.completedByUid == request.auth.uid &&
          request.resource.data.completedAt == request.time
        ));
      allow delete: if admin();
    }
    match /auditoria/{logId} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['taskId','action','actorUid','actorEmail','actorName','note','at'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['andamento','concluida','exclusao']
        && (request.resource.data.action != 'exclusao' || admin())
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0
        && request.resource.data.actorName.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1500
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
